* text=auto eol=lf

*.cs text diff=csharp
*.csproj text
*.props text
*.targets text
*.slnx text
*.json text
*.yml text
*.yaml text
*.md text
*.sh text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.snupkg binary
*.nupkg binary

# Verify snapshots: keep exact bytes, never normalize
*.verified.* text eol=lf -diff
