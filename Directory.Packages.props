<Project>

  <!-- Central Package Management. Every PackageReference in the repo takes its version from here. -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- EF Core / Npgsql. Floor, not exact pins - see DESIGN.md D11 for why these specific versions. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.4" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.4" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <!-- Build / packaging -->
  <ItemGroup>
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <!-- HDST001 analyzer (src/Hindsight.Analyzers), bundled into the main package's analyzers/dotnet/cs -
       not a separate NuGet package (DESIGN.md D4).

       None of the Microsoft.CodeAnalysis.* packages the analyzer or its tests need are centrally pinned
       here, deliberately: Microsoft.EntityFrameworkCore.Design (a dependency of the samples, for
       `dotnet ef`) pulls Microsoft.CodeAnalysis.CSharp.Workspaces/.CSharp/.Common at an exact (`=`)
       5.0.0 across its whole transitive graph, and with CentralPackageTransitivePinningEnabled a
       *central* PackageVersion for any of those ids - at any version other than that exact 5.0.0 -
       forces the samples' unrelated graph to the central version too and breaks it (NU1608/NU1107).
       src/Hindsight.Analyzers/Hindsight.Analyzers.csproj and
       tests/Hindsight.Analyzers.Tests/Hindsight.Analyzers.Tests.csproj pin their own Roslyn package
       versions locally with PackageReference's VersionOverride instead - a per-project override that
       central package transitive pinning does not propagate to the rest of the solution. -->

  <!-- Analyzer tests (tests/Hindsight.Analyzers.Tests). The xunit-specific testing packages
       (Microsoft.CodeAnalysis.CSharp.Analyzer.Testing.XUnit and friends) are deprecated upstream in
       favor of the generic package + Microsoft.CodeAnalysis.Testing.DefaultVerifier, which throws plain
       exceptions xunit.v3 reports as failures like any other - no framework-specific adapter needed.
       This one package ID is safe to pin centrally: EF Core Design has no dependency on the *testing*
       framework, only on the compiler packages called out above. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
  </ItemGroup>

  <!-- Tests -->
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.4.1" />
    <PackageVersion Include="Verify.XunitV3" Version="33.0.2" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <!-- Not a supported Hindsight provider (README.md non-goals) - used only by
         HindsightOptionsExtensionTests to prove Validate() rejects a non-Npgsql provider. Pinned to
         the same floor as the EF Core / Npgsql group above so it doesn't force a downgrade conflict. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.4" />
    <!-- Transitive via Microsoft.EntityFrameworkCore.Sqlite 10.0.4 - that version's own dependency
         graph pulls SQLitePCLRaw.lib.e_sqlite3 2.1.11, which has a known high-severity advisory
         (GHSA-2m69-gcr7-jv3q). Pinned directly (see the matching PackageReference in
         Hindsight.Tests.csproj) to the patched version instead of raising the whole EF Core floor. -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>

  <!-- Benchmarks -->
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

</Project>
