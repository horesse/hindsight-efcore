{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": ["**/*.csproj"]
        }
      ],
      "dest": "api",
      "outputFormat": "apiPage",
      "includePrivateMembers": false,
      "disableGitFeatures": false,
      "properties": {
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      { "files": ["**/*.{md,yml}"], "exclude": ["_site/**", "obj/**"] }
    ],
    "resource": [
      { "files": ["images/**"] }
    ],
    "output": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appName": "Hindsight",
      "_appTitle": "Hindsight — temporal entities for EF Core on PostgreSQL",
      "_appFooter": "Hindsight · MIT · <a href=\"https://github.com/horesse/hindsight-efcore\">GitHub</a>",
      "_enableSearch": true,
      "_gitContribute": {
        "repo": "https://github.com/horesse/hindsight-efcore",
        "branch": "master"
      },
      "_gitUrlPattern": "github",
      "pdf": false
    },
    "xref": ["https://learn.microsoft.com/en-us/dotnet/.xrefmap.json"],
    "postProcessors": [],
    "markdownEngineName": "markdig",
    "noLangKeyword": false,
    "keepFileLink": false,
    "disableGitFeatures": false
  }
}
