<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Every C# sample on the docs site is a #region in this project, imported into a page with
    `<<< @/snippets/<File>.cs#<region>` (docs/README.md → Code samples). The project is part of the
    solution, so every `dotnet build` compiles the samples against the current public API: a renamed
    or removed API breaks the build instead of leaving a wrong sample on the site. Compiled, never run.
  -->

  <PropertyGroup>
    <RootNamespace>Hindsight.Docs.Snippets</RootNamespace>
    <!-- Samples are not held to library-grade analysis (same as samples/). -->
    <AnalysisLevel>latest-minimum</AnalysisLevel>
    <NoWarn>$(NoWarn);CS1591;CA1303;CA1305;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The change-context samples read the current user from ASP.NET Core's IHttpContextAccessor. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Hindsight.EntityFrameworkCore.PostgreSQL/Hindsight.EntityFrameworkCore.PostgreSQL.csproj" />
    <!-- The `Policy` entity every sample uses. -->
    <ProjectReference Include="../../samples/InsuranceSample/InsuranceSample.csproj" />
  </ItemGroup>

</Project>
