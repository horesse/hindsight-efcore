<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <base href="/" />
    @* Static server rendering only: no blazor.web.js, no JavaScript at all. The styles are inline so the
       sample has no wwwroot and no front-end build. *@
    <style>
        :root { color-scheme: light dark; --muted: #6b7280; --line: #d1d5db; --accent: #2563eb; --hl: #eff6ff; --del: #b91c1c; --ins: #15803d; }
        @@media (prefers-color-scheme: dark) { :root { --muted: #9ca3af; --line: #374151; --accent: #60a5fa; --hl: #1e293b; --del: #f87171; --ins: #4ade80; } }
        body { font: 15px/1.5 system-ui, sans-serif; max-width: 1100px; margin: 0 auto; padding: 0 16px 48px; }
        header { display: flex; align-items: baseline; gap: 16px; border-bottom: 1px solid var(--line); margin-bottom: 24px; }
        header a { color: inherit; text-decoration: none; }
        header span { color: var(--muted); }
        a { color: var(--accent); }
        table { border-collapse: collapse; width: 100%; margin: 8px 0 24px; }
        th, td { text-align: left; padding: 6px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
        th { font-weight: 600; color: var(--muted); font-size: 13px; }
        td.num { text-align: right; font-variant-numeric: tabular-nums; }
        .time, .nowrap { font-variant-numeric: tabular-nums; white-space: nowrap; }
        .muted { color: var(--muted); }
        .op { font-size: 12px; font-weight: 600; text-transform: uppercase; }
        .op-Insert { color: var(--ins); } .op-Delete { color: var(--del); } .op-Update { color: var(--accent); }
        tr.active { background: var(--hl); }
        ul.changes { margin: 0; padding: 0; list-style: none; }
        del { color: var(--del); } ins { color: var(--ins); text-decoration: none; }
        form { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
        input[type=text] { font: inherit; padding: 4px 8px; min-width: 22em; }
        button { font: inherit; padding: 4px 12px; }
        .status-deleted { color: var(--del); }
    </style>
    <HeadOutlet />
</head>
<body>
    <Routes />
</body>
</html>
