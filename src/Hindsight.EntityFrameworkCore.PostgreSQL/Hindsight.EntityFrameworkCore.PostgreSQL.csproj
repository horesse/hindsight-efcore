<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Hindsight</RootNamespace>
    <AssemblyName>Hindsight.EntityFrameworkCore.PostgreSQL</AssemblyName>
    <PackageId>Hindsight.EntityFrameworkCore.PostgreSQL</PackageId>
    <Title>Hindsight for EF Core (PostgreSQL)</Title>
    <Description>System-versioned temporal entities for EF Core on PostgreSQL. No database extensions, no superuser: history tables live in your EF Core migrations, change context (who / why / correlation id) comes from the application, and AsOf() queries are plain LINQ.</Description>
    <PackageTags>efcore;entity-framework-core;postgresql;npgsql;temporal;system-versioned;history;audit;as-of</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hindsight.Tests" />
    <InternalsVisibleTo Include="Hindsight.IntegrationTests" />
  </ItemGroup>

  <!-- HDST001 (DESIGN.md D4): the analyzer ships bundled in this package, not as a separate NuGet
       package. ReferenceOutputAssembly="false" + OutputItemType="Analyzer" is the standard MSBuild
       incantation for "build this project and load its output as a C# analyzer for the current
       project" - it also makes `dotnet build` here run HDST001 against Hindsight's own source
       (currently a no-op: the library defines IsTemporal(), it doesn't call it against a concrete
       entity type, so the analyzer never has a temporal type to match against). -->
  <ItemGroup>
    <ProjectReference Include="..\Hindsight.Analyzers\Hindsight.Analyzers.csproj"
                       ReferenceOutputAssembly="false"
                       OutputItemType="Analyzer" />
  </ItemGroup>

  <!-- Packs the analyzer's own build output into analyzers/dotnet/cs - the folder NuGet/MSBuild loads
       C# analyzers from for every project that references this package (the same convention
       Microsoft.CodeAnalysis.PublicApiAnalyzers itself, referenced above, ships under). Visible="false"
       keeps it out of the package's file listing in tools that show package contents as if they were
       ordinary content; DevelopmentDependency is not set here because this package is a real runtime
       dependency, not an analyzer-only one - only the analyzer *file* is build-time-only, not the
       package as a whole. -->
  <Target Name="_HindsightAddAnalyzerToPackage" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="..\Hindsight.Analyzers\Hindsight.Analyzers.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="_HindsightAnalyzerAssembly" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(_HindsightAnalyzerAssembly)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
